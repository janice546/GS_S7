# Ignore files generated by Keil and other tools
/Programs/*/DebugConfig/
/Programs/*/ITSboard/
/Programs/*/RTE/
/Programs/*/out/
/Programs/*/tmp/
/Programs/*/*.cbuild-idx.yml
/Programs/*/*.cbuild-pack.yml
/Programs/**/.clangd
/Programs/*/clang_tidy_result.txt
__pycache__/

# Ignore User specific setting
/Programs/*/*.uvguix.*

# Ignore generated build files
/Programs/*/tmp/
/Programs/*/out/

# Ignore Git Bash crash dumps
*.stackdump

